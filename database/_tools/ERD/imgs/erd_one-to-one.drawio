        <mxCell id="l37rcTFWyAAdQefQlm9Q-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFF66);" value="&lt;div&gt;WRONG!&lt;/div&gt;&lt;div&gt;If you define&amp;nbsp;(FK)&amp;nbsp;a relationship existence between two entities in both sides, you are storing the same information twice on the db. And its NOT good at all.&lt;/div&gt;" vertex="1">
